#!/bin/sh
# Pre-commit hook for the Virbooks monorepo.
# Runs ruff (check + format) and mypy when virbooks-api files are staged.
# Runs lint-staged when virbooks-app files are staged.
# POSIX sh; works on Git Bash, WSL, macOS, and Linux.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

API_FILES=$(echo "$STAGED_FILES" | grep "^virbooks-api/")
APP_FILES=$(echo "$STAGED_FILES" | grep "^virbooks-app/")

EXIT_CODE=0

if [ -n "$API_FILES" ]; then
    API_DIR="$REPO_ROOT/virbooks-api"

    if [ -x "$API_DIR/venv/Scripts/python.exe" ]; then
        PYTHON="$API_DIR/venv/Scripts/python.exe"
    elif [ -x "$API_DIR/venv/bin/python" ]; then
        PYTHON="$API_DIR/venv/bin/python"
    else
        echo '[pre-commit] venv python not found at virbooks-api/venv/. Create it with: python -m venv virbooks-api/venv && pip install -e "virbooks-api[dev]"' 1>&2
        exit 1
    fi

    echo "[pre-commit] Running ruff check --fix for virbooks-api..."
    "$PYTHON" -m ruff check --fix "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running ruff format for virbooks-api..."
    "$PYTHON" -m ruff format "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))

    echo "[pre-commit] Running mypy for virbooks-api..."
    "$PYTHON" -m mypy \
        --config-file="$API_DIR/pyproject.toml" \
        "$API_DIR"
    EXIT_CODE=$((EXIT_CODE + $?))
fi

if [ -n "$APP_FILES" ]; then
    echo "[pre-commit] Running lint-staged for virbooks-app..."
    if command -v npx > /dev/null; then
        (cd "$REPO_ROOT/virbooks-app" && npx --no-install lint-staged)
        EXIT_CODE=$((EXIT_CODE + $?))
    else
        echo '[pre-commit] `npx` not found. Did you install Node.js?' 1>&2
        exit 1
    fi
fi

exit $EXIT_CODE
